{
  "name": "emojideck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:generate": "node scripts/generate-emoji-data.mjs",
    "data:check": "node scripts/generate-emoji-data.mjs --check",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "quality:check": "node scripts/check-build.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
